# Gradle 相关
# Gradle 缓存目录
.gradle/
# 构建产物
build/
# 所有模块的 build 目录
**/build/
# 本地配置（包含 SDK 路径，不要提交）
local.properties

# IDE 相关
# IntelliJ IDEA 配置
.idea/
# IDEA 模块文件
*.iml
# VSCode 配置
.vscode/
# JetBrains Fleet 配置
.fleet/
# C++ 构建缓存
.cxx/

# Android Studio
# 性能分析数据
captures/
# 原生构建缓存
.externalNativeBuild/

# 编译产物（不要提交）
# APK 文件
*.apk
# AAB 文件
*.aab
*.ap_
*.dex
*.class

# 临时文件
*.log
*.tmp
*.bak
*.swp

# 操作系统
# macOS
.DS_Store
# Windows
Thumbs.db
desktop.ini

# 其他
# 性能分析文件
*.hprof

# Gradle 相关
.gradle/                  # Gradle 缓存目录
build/                    # 构建产物
**/build/                 # 所有模块的 build 目录
local.properties          # 本地配置（包含 SDK 路径，不要提交）

# IDE 相关
.idea/                    # IntelliJ IDEA 配置
*.iml                     # IDEA 模块文件
.vscode/                  # VSCode 配置
.fleet/                   # JetBrains Fleet 配置
.cxx/                     # C++ 构建缓存

# Android Studio
captures/                 # 性能分析数据
.externalNativeBuild/     # 原生构建缓存

# 编译产物（不要提交）
*.apk                     # APK 文件
*.aab                     # AAB 文件
*.ap_
*.dex
*.class

# 临时文件
*.log
*.tmp
*.bak
*.swp

# 操作系统
.DS_Store                 # macOS
Thumbs.db                 # Windows
desktop.ini               # Windows

# 其他
*.hprof                   # 性能分析文件